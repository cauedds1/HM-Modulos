{
  "name": "hm-modulos",
  "version": "0.2.0",
  "private": true,
  "description": "Ferramenta de bancada para leitura, sincronizacao e reparo de dumps de modulos automotivos (BCCM / airbag) PSA. Nome do produto a definir (P3).",
  "main": "src/main/main.js",
  "scripts": {
    "start": "node server/index.js",
    "app": "electron .",
    "start:server": "node server/index.js",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder",
    "build:win": "electron-builder --win"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.hmmecanica.modulos",
    "productName": "HM Modulos",
    "files": ["src/**/*", "profiles/**/*", "web/**/*"],
    "win": {
      "target": "nsis",
      "artifactName": "HM-Modulos-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
