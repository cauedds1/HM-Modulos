# Variáveis de ambiente do servidor (copie para .env em dev; na Railway,
# configure em Variables). O arquivo .env NÃO vai para o repositório.

# Banco Postgres. Na Railway, o plugin Postgres cria esta variável sozinho.
# Em desenvolvimento local, aponte para o seu Postgres:
# DATABASE_URL=postgres://usuario:senha@localhost:5432/hmmodulos
DATABASE_URL=

# Segredo para assinar os tokens de login. Gere um valor aleatório longo.
# Sem ele, os logins caem a cada reinício do servidor.
# Ex.: TOKEN_SECRET=uma-frase-bem-grande-e-aleatoria-123456
TOKEN_SECRET=

# Chave de administrador — necessária para RECARREGAR créditos de uma oficina.
# Só você deve conhecer. Ex.: ADMIN_KEY=algo-secreto-so-seu
ADMIN_KEY=

# Porta (a Railway define sozinha; em local, o padrão é 3000).
# PORT=3000
